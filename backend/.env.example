# Server Port (default: 3000)
PORT=3000

# Secret key for signing self-made JWT tokens (minimum 32 characters)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Neon or PostgreSQL Connection URL (Leave blank to use local fallback memory store)
# Example for Neon: postgresql://username:password@ep-cool-flower-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
